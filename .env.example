# OpsDesk 根目录环境变量样例（复制为 .env 后按本机填写；勿提交 .env）
#
# ---- 部署身份 ----
APP_NAME=AIQuant_OpsDesk
APP_ENV=DEV
DASHBOARD_PORT=7865

# ---- 内嵌板块日更（相对本树即可）----
# 可省略；scheduler 默认用 vendor/market_data_prep
# MARKET_DATA_PREP_DIR=
# CASE_A_BOARD_DATA_PREP_DIR=   # 旧名，仍兼容

# ---- 大 QMT 文件桥 ----
BROKER_MODE=file_bridge
QMT_BRIDGE_DIR=
QMT_ACCOUNT_ID=
ACCOUNT_ID=
QMT_PATH=
SESSION_ID=10001

# ---- 投研 / 推送 ----
DASHSCOPE_API_KEY=
DINGTALK_WEBHOOK=

# ---- MySQL（原 02_行情数据采集 QUANT_TRADE_*；也可放 vendor/db_env/.env）----
QUANT_TRADE_CHARLES_DB_HOST=localhost
QUANT_TRADE_CHARLES_DB_PORT=3306
QUANT_TRADE_CHARLES_DB_USER=root
QUANT_TRADE_CHARLES_DB_PASSWORD=
QUANT_TRADE_CHARLES_DB_NAME=quant_trade
